{
    "name"       : "oasis/slimapp",
    "description": "slim app framework",
    "type"       : "library",
    "require"    : {
        "php"                         : ">=8.5",
        "symfony/dependency-injection": "^8.0",
        "symfony/config"              : "^8.0",
        "symfony/console"             : "^8.0",
        "symfony/finder"              : "^8.0",
        "symfony/filesystem"          : "^8.0",
        "oasis/logging"               : "^3.0",
        "oasis/utils"                 : "^3.2",
        "oasis/http"                  : "^3.8"
    },
    "require-dev": {
        "phpunit/phpunit"      : "^13",
        "doctrine/orm"         : "^3.6",
        "oasis/aws-wrappers"   : "^3.0",
        "oasis/dynamodb-odm"   : "^2.0",
        "oasis/doctrine-addon" : "^3.1",
        "giorgiosironi/eris"   : "^1.1",
        "phpstan/phpstan": "^2.1"
    },
    "suggest"    : {
        "ext-pcntl": "*"
    },
    "license"    : "MIT",
    "authors"    : [
        {
            "name" : "Minhao Zhang",
            "email": "minhao.zhang@qq.com"
        }
    ],
    "bin"        : [
        "bin/slimapp"
    ],
    "autoload"   : {
        "psr-4": {
            "Oasis\\SlimApp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oasis\\SlimApp\\Tests\\": "tests/ut/",
            "Oasis\\SlimApp\\Tests\\Integration\\Fixtures\\": "tests/integration/fixtures/"
        }
    },
    "config": {
        "audit": {
            "abandoned": "report",
            "block-insecure": false
        }
    }
}
